# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# NextAuth v4
NEXTAUTH_URL=https://family-bridge-omega.vercel.app
NEXTAUTH_SECRET=generate_with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Google OAuth (console.cloud.google.com)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Neon PostgreSQL (neon.tech)
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require